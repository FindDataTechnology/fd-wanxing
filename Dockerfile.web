# wanxing-web static image, POOL-CONTEXT variant (add-stats-plane-v1):
# identical to wanxing-web/Dockerfile but every COPY path is anchored to the
# repo root, because the generic build pool builds with context '.'.
#   pool: BUILD_DOCKERFILE=Dockerfile.web, BUILD_CONTEXT=., image=wanxing-web
#
# ⚠️ 这份必须与 wanxing-web/Dockerfile 保持**行为**等价。2026-11-17 栽过一次：
# nginx.conf 改成 envsubst 模板后只更新了子目录那份，根这份仍把 nginx.conf 原样
# COPY 成 default.conf ⇒ nginx 启动即 `unknown "wanxing_facade_upstream" variable`
# ⇒ CrashLoopBackOff（生产新 pod 全崩，靠旧 pod 顶着）。改任何一边，两边一起改。
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY wanxing-web/package.json wanxing-web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY wanxing-web/ ./
RUN npm run build

FROM nginx:1.27-bookworm
# envsubst 来自 gettext，标准 nginx 镜像不带它（fd-wire/web 2026-11-16 栽过一次）。
RUN apt-get update \
 && apt-get install -y --no-install-recommends gettext-base \
 && rm -rf /var/lib/apt/lists/*
# server 块是模板：启动时只替换 ${WANXING_FACADE_UPSTREAM}，渲染成普通静态配置再交给
# nginx——转发语义与手写静态配置完全一致（变量式 proxy_pass 不是同一个东西，它改变
# URI 传递方式，2026-11-16 曾因此打挂全站 /api）。
COPY wanxing-web/nginx.conf /etc/nginx/conf.d/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html
# 默认值是 IP 字面量：没有集群 DNS 的环境（构建池 smoke / 本地）也能启动；
# 生产由 deploy 的 env 指到真实 Service 名。
ENV WANXING_FACADE_UPSTREAM=127.0.0.1:3080
CMD ["/bin/sh", "-c", "set -e; command -v envsubst >/dev/null || { echo 'FATAL: envsubst missing (need gettext-base)' >&2; exit 1; }; envsubst '$WANXING_FACADE_UPSTREAM' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
