# wanxing-web static image, POOL-CONTEXT variant (add-stats-plane-v1):
# identical to wanxing-web/Dockerfile but every COPY path is anchored to the
# repo root, because the generic build pool builds with context '.' and a
# fixed root Dockerfile path (no BUILD_CONTEXT plumb-through, no build-args).
#   pool: BUILD_DOCKERFILE=Dockerfile.web, image=wanxing-web
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY wanxing-web/package.json wanxing-web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY wanxing-web/ ./
RUN npm run build

FROM nginx:1.27-bookworm
COPY wanxing-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
